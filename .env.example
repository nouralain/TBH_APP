# Copy to .env.development (npm run dev) or .env.production (npm start) and fill in.
# Both real files are git-ignored. See README.md for what each variable does.

# --- server ---
PORT=3000
APP_NAME=TBH
# comma-separated frontend origins allowed by CORS (empty = all in development, none in production)
CORS_ORIGINS=http://localhost:4200
# number of proxies in front of the app when deployed (ex: 1), empty locally
TRUST_PROXY=

# --- databases ---
DB_URI=mongodb://127.0.0.1:27017/tbh
REDIS_URL=redis://127.0.0.1:6379

# --- phone encryption (AES) ---
ENC_ALGORITHM=aes-256-cbc
IV_LENGTH=16
# exactly 32 characters for aes-256
ENC_KEY=change-me-32-characters-long-key

# --- JWT (expiry in seconds) ---
ACCESS_TOKEN_SIGNATURE=change-me-access-secret
ACCESS_TOKEN_EXPIRY=1800
REFRESH_TOKEN_SIGNATURE=change-me-refresh-secret
REFRESH_TOKEN_EXPIRY=604800

# --- guest IP hashing (falls back to ACCESS_TOKEN_SIGNATURE) ---
IP_HASH_SECRET=change-me-ip-hash-secret

# --- email (Gmail app password) ---
MAILER_EMAIL=you@gmail.com
MAILER_PASSKEY=gmail-app-password

# --- Google sign-in (OAuth web client id) ---
WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
